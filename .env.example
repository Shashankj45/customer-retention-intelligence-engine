# Environment Configuration Template
# Copy to .env and adjust values for your environment

# Environment Mode: 'development', 'production', 'testing'
APP_ENV=development

# Database Settings
# For PostgreSQL (Production / Docker):
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=customer_intelligence
DB_USER=postgres
DB_PASSWORD=postgres

# Local SQLite fallback for immediate zero-setup execution:
SQLITE_DB_PATH=data/customer_intelligence.db

# MLflow Tracking URI (Local directory or remote server)
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=customer_churn_intelligence

# Data Pipeline Parameters
NUM_CUSTOMERS=5000
RANDOM_SEED=42

# Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_BASE=dark
