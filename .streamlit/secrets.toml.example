# Streamlit Cloud Secrets Configuration Template
# For public demo, SQLite is used automatically with zero secrets required.
# If connecting to an external production PostgreSQL database, paste the following in Streamlit Cloud > Settings > Secrets:

# DB_TYPE = "postgresql"
# DB_HOST = "your-postgres-host.aws.neon.tech"
# DB_PORT = "5432"
# DB_NAME = "customer_intelligence"
# DB_USER = "db_user"
# DB_PASSWORD = "db_password"
# DB_READONLY = "true"
